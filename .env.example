# 이 파일을 .env로 복사한 뒤 각 서비스에서 발급받은 키를 입력하세요.
# 실제 .env 파일은 Git에 올리지 않습니다. 키를 바꾸면 서버를 다시 실행하세요.

# 서울교통공사_최단경로이동정보
SEOUL_TRANSIT_API_KEY=

# 서울특별시 대중교통환승경로 조회
SEOUL_BUS_PATH_API_KEY=

# 서울특별시_정류소정보조회 서비스
SEOUL_BUS_STATION_API_KEY=

# 카카오 장소 검색·도보 경로·택시 예상 요금 (카카오모빌리티)
KAKAO_REST_API_KEY=

# 현재 화면에서는 사용하지 않는 선택 항목
KAKAO_JAVASCRIPT_KEY=

PORT=8765

# Vercel 전용: 32자 이상의 무작위 문자열. 실제 값은 Vercel 환경변수로만 등록하세요.
# 로컬 실행만 하는 경우 비워 둡니다.
JOURNEY_TOKEN_SECRET=
